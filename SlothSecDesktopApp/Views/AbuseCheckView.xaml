<UserControl x:Class="SlothSecDesktopApp.Views.AbuseCheckerView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    
    <Grid Margin="20">
        <TextBlock Text="Abuse Checker" 
            FontSize="24" 
            FontWeight="Bold" 
            Margin="0,0,0,20"/>

        <stackPanel Orientation="Horizontal" Margin="0 0 0 20">
            <TextBox Width="300"
                     Height="32"
                     FontSize="16"
                     Margin="0,0,10,0"
                     Text="{Binding IpAddress, UpdateSourceTrigger=PropertyChanged}"
                     PlaceholderText="Enter IP address"/>
            <Button Content="Check IP"
                    Width="120"
                    Height="32"
                    Command="{Binding CheckIpCommand}"/>
        </stackPanel>

        <TextBlock Text="{Binding Result}" 
            FontSize="16"
            TextWrapping="Wrap"
            Margin="0,600,0,0"/>
    </Grid>        
</UserControl>